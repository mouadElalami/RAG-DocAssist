# RAG-DocAssist Configuration

APP_NAME=RAG-DocAssist
APP_VERSION=1.0.0
DEBUG=False

# LLM Providers Configuration
# Options: gemini, openai, ollama, mock
LLM_PROVIDER=gemini

# Google Gemini API Key
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# OpenAI API Key
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Ollama Local LLM
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# Embeddings & Vector Store
# Options: sentence-transformers, huggingface, openai, mock
EMBEDDING_PROVIDER=sentence-transformers
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2

# Chunking Parameters
CHUNK_SIZE=600
CHUNK_OVERLAP=120
DEFAULT_TOP_K=4

# Server Configuration
HOST=127.0.0.1
PORT=8000
